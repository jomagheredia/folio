<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:560px;font-family:Georgia, 'Times New Roman', serif;color:#1a1a1a;">
  <tr>
    <td style="padding-bottom:16px;font-family:system-ui, -apple-system, sans-serif;font-size:14px;line-height:1.5;color:#555555;">
      <%= @sender.email %> shared <%= @items.size == 1 ? "a find" : "finds" %> with you via Folio.
    </td>
  </tr>

  <% if @share.note.present? %>
    <tr>
      <td style="padding-bottom:20px;font-size:16px;line-height:1.6;">
      <%= simple_format(@share.note) %>
      </td>
    </tr>
  <% end %>

  <tr>
    <td style="padding-bottom:24px;font-size:16px;line-height:1.6;">
      <%= simple_format(@share.body) %>
    </td>
  </tr>

  <% @items.each do |item| %>
    <tr>
      <td style="padding-bottom:20px;border-top:1px solid #e5e5e5;padding-top:16px;">
        <% if item[:image_url].present? %>
          <% if item[:url].present? %>
            <a href="<%= item[:url] %>" style="text-decoration:none;">
              <img src="<%= item[:image_url] %>" alt="" width="240" style="display:block;max-width:240px;height:auto;border:0;margin-bottom:8px;">
            </a>
          <% else %>
            <img src="<%= item[:image_url] %>" alt="" width="240" style="display:block;max-width:240px;height:auto;border:0;margin-bottom:8px;">
          <% end %>
        <% end %>
        <div style="font-family:system-ui, -apple-system, sans-serif;font-size:16px;font-weight:600;color:#1a1a1a;">
          <% if item[:url].present? %>
            <a href="<%= item[:url] %>" style="color:#1a1a1a;text-decoration:underline;"><%= item[:title] %></a>
          <% else %>
            <%= item[:title] %>
          <% end %>
        </div>
        <% if item[:url].present? %>
          <div style="font-family:system-ui, -apple-system, sans-serif;font-size:13px;color:#555555;margin-top:4px;">
            <a href="<%= item[:url] %>" style="color:#555555;"><%= item[:url] %></a>
          </div>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
