#!/usr/bin/env bash
# Restart a Procfile command if it crashes, so Foreman/Hivemind do not
# tear down Rails + Vite + jobs together. SIGINT/SIGTERM on this wrapper
# stop the loop so `bin/dev` can still shut down. A SIGTERM on the child
# alone (killed Vite, OOM, etc.) is treated as a crash and restarted.
set -u

stopping=0
child=""
# Linux has setsid(1); macOS does not. Isolated process groups let us reap
# npm/node grandchildren without signaling Foreman's group. Without setsid
# we only signal the direct child PID.
if command -v setsid >/dev/null 2>&1; then
  use_setsid=1
else
  use_setsid=0
fi

stop_child() {
  if [[ -z "$child" ]]; then
    return
  fi
  if [[ $use_setsid -eq 1 ]]; then
    kill -TERM -"$child" 2>/dev/null || kill -TERM "$child" 2>/dev/null || true
  else
    kill -TERM "$child" 2>/dev/null || true
  fi
  wait "$child" 2>/dev/null || true
  if [[ $use_setsid -eq 1 ]]; then
    kill -KILL -"$child" 2>/dev/null || true
  fi
}

term() {
  stopping=1
  stop_child
  exit 0
}

trap term INT TERM

if [[ $# -eq 0 ]]; then
  echo "usage: bin/keep-alive <command> [args...]" >&2
  exit 1
fi

stamp() {
  date -Iseconds 2>/dev/null || date "+%Y-%m-%dT%H:%M:%S%z"
}

while true; do
  if [[ $use_setsid -eq 1 ]]; then
    setsid "$@" &
  else
    "$@" &
  fi
  child=$!
  wait "$child"
  code=$?
  leftover=$child
  child=""
  # Reap leftover descendants holding the port (e.g. node after npm dies).
  # Only safe when the child is its own process group leader (setsid).
  if [[ $use_setsid -eq 1 ]]; then
    kill -TERM -"$leftover" 2>/dev/null || true
    kill -KILL -"$leftover" 2>/dev/null || true
  fi

  if [[ $stopping -eq 1 ]]; then
    exit 0
  fi

  # 0 = the command finished on its own. Exit so Foreman can stop the group
  # (e.g. a one-shot process). Any other status, including 143 from a killed
  # child, is a crash — restart instead of taking Rails down with it.
  if [[ $code -eq 0 ]]; then
    exit 0
  fi

  echo "$(stamp) $1 exited with $code; restarting in 1s" >&2
  sleep 1
done
